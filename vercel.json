{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "ADMIN_USER": "@admin_user",
    "ADMIN_PASSWORD": "@admin_password",
    "SECRET_KEY": "@secret_key",
    "DB_PATH": "/tmp/club.db"
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ]
}
